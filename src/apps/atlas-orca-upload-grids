set -Eeuo pipefail

usage() {
    cat <<'EOF'
Usage:
    atlas-orca-upload-grids --output-dir <directory> [--url <url>] [--force]
                            [--dryrun] [--help]

Uploads the .atlas grid data files and grids.yaml generated by
atlas-orca-recreate-grids. The default target is:

    https://sites.ecmwf.int/repository/atlas/grids/orca/experimental

The .atlas grid data files are uploaded first and grids.yaml is uploaded last.
Each file is attempted up to three times. SitesCTL resumes interrupted large-file
uploads by default.

Options:
    --output-dir <directory>
                    Directory containing grids.yaml and one or more .atlas grid
                    data files.
    --url <url>     Target Sites URL. The URL path must contain the SitesCTL
                    space, site name, and optional destination path.
                    (default: https://sites.ecmwf.int/repository/atlas/grids/orca/experimental).
    --force         Upload without asking for confirmation.
    --dryrun        Validate local input and print sanitized SitesCTL commands
                    without uploading or requesting an access token.
    --help          Show this help and exit.

Environment:
    SITES_API_TOKEN Sites API access token. When unset, the token is read from
                    an interactive terminal with input hidden. Never pass the
                    token as a command-line option to this wrapper.

Security:
    The token is never printed by this wrapper. SitesCTL receives it through its
    required --api-authentication-token option, so it may briefly be visible to
    other local users through process inspection while an upload is running.

Requirements:
    If sitesctl is not found on PATH, this script offers to install the latest
    official macOS or Linux AMD64 binary in ~/.local/bin. Apple Silicon Macs
    require Rosetta 2. Other architectures are not currently published.
EOF
}

output_dir=""
target_url="https://sites.ecmwf.int/repository/atlas/grids/orca/experimental"
force=false
dryrun=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --output-dir)
            if [[ $# -lt 2 || -z "$2" ]]; then
                echo "ERROR: --output-dir requires a non-empty value" >&2
                usage >&2
                exit 2
            fi
            output_dir=$2
            shift 2
            ;;
        --url)
            if [[ $# -lt 2 || -z "$2" ]]; then
                echo "ERROR: --url requires a non-empty value" >&2
                usage >&2
                exit 2
            fi
            target_url=$2
            shift 2
            ;;
        --force)
            force=true
            shift
            ;;
        --dryrun)
            dryrun=true
            shift
            ;;
        --help)
            usage
            exit 0
            ;;
        *)
            echo "ERROR: unknown option '$1'" >&2
            usage >&2
            exit 2
            ;;
    esac
done

target_url=${target_url%/}
url_prefix="https://sites.ecmwf.int/"
if [[ "${target_url}" != "${url_prefix}"* ]]; then
    echo "ERROR: --url must start with ${url_prefix}" >&2
    exit 2
fi
url_path=${target_url#${url_prefix}}
if [[ "${url_path}" != */* || "${url_path}" == *//* || "${url_path}" == *\?* || "${url_path}" == *\#* ]]; then
    echo "ERROR: --url must identify a SitesCTL space and site without empty path segments, a query, or a fragment" >&2
    exit 2
fi
site_space=${url_path%%/*}
site_path=${url_path#*/}
site_name=${site_path%%/*}
if [[ -z "${site_space}" || -z "${site_name}" ]]; then
    echo "ERROR: --url must identify a SitesCTL space and site" >&2
    exit 2
fi
if [[ "${site_path}" == */* ]]; then
    destination="/${site_path#*/}"
else
    destination="/"
fi

if [[ -z "${output_dir}" ]]; then
    echo "ERROR: --output-dir is required" >&2
    usage >&2
    exit 2
fi
if [[ "${output_dir}" != /* ]]; then
    output_dir="${PWD}/${output_dir}"
fi
if [[ ! -d "${output_dir}" ]]; then
    echo "ERROR: output directory not found: ${output_dir}" >&2
    exit 1
fi
if [[ ! -f "${output_dir}/grids.yaml" ]]; then
    echo "ERROR: generated grid registry not found: ${output_dir}/grids.yaml" >&2
    exit 1
fi

shopt -s nullglob
atlas_files=("${output_dir}"/*.atlas)
if [[ ${#atlas_files[@]} -eq 0 ]]; then
    echo "ERROR: no .atlas grid data files found in ${output_dir}" >&2
    exit 1
fi

install_sitesctl() {
    local kernel
    local architecture
    local platform
    local repository_index
    local artifact
    local download_url
    local install_dir="${HOME}/.local/bin"
    local install_path="${install_dir}/sitesctl"
    local temporary_file
    local answer

    kernel=$(uname -s)
    architecture=$(uname -m)
    case "${kernel}" in
        Darwin)
            platform=darwin
            if [[ "${architecture}" == arm64 ]]; then
                echo "ℹ️  SitesCTL is available only for AMD64; Apple Silicon requires Rosetta 2."
            elif [[ "${architecture}" != x86_64 ]]; then
                echo "ERROR: SitesCTL is not published for macOS architecture ${architecture}" >&2
                return 1
            fi
            ;;
        Linux)
            platform=linux
            if [[ "${architecture}" != x86_64 && "${architecture}" != amd64 ]]; then
                echo "ERROR: SitesCTL is not published for Linux architecture ${architecture}" >&2
                return 1
            fi
            ;;
        *)
            echo "ERROR: automatic SitesCTL installation is not supported on ${kernel}" >&2
            return 1
            ;;
    esac

    if [[ ! -t 0 ]]; then
        echo "ERROR: sitesctl is not found on PATH and no interactive terminal is available" >&2
        return 1
    fi
    printf '⬇️  Install the latest SitesCTL for %s AMD64 in %s? [y/N] ' "${platform}" "${install_path}"
    read -r answer
    case "${answer}" in
        y|Y|yes|YES) ;;
        *)
            echo "ERROR: sitesctl is required" >&2
            return 1
            ;;
    esac

    if ! command -v curl >/dev/null 2>&1; then
        echo "ERROR: curl is required to install sitesctl" >&2
        return 1
    fi

    repository_index="https://get.ecmwf.int/service/rest/repository/browse/sites-cli/${platform}/"
    artifact=$(curl -fsSL "${repository_index}" |
        sed -n "s|.*href=[\"'][^\"']*/\(sites-${platform}-amd64-[0-9.]*\)[\"'].*|\1|p" |
        sort | tail -n 1)
    if [[ -z "${artifact}" ]]; then
        echo "ERROR: could not determine the latest SitesCTL release from ${repository_index}" >&2
        return 1
    fi

    download_url="https://get.ecmwf.int/repository/sites-cli/${platform}/${artifact}"
    mkdir -p "${install_dir}"
    temporary_file=$(mktemp "${install_dir}/sitesctl.XXXXXX")
    trap 'rm -f "${temporary_file}"' RETURN
    echo "⬇️  Downloading ${artifact}..."
    curl -fL "${download_url}" -o "${temporary_file}"
    chmod 755 "${temporary_file}"
    if [[ "${platform}" == darwin ]] && command -v xattr >/dev/null 2>&1; then
        xattr -d com.apple.quarantine "${temporary_file}" 2>/dev/null || true
    fi
    mv "${temporary_file}" "${install_path}"
    trap - RETURN
    echo "✅ Installed SitesCTL at ${install_path}"
    if [[ ":${PATH}:" != *":${install_dir}:"* ]]; then
        echo "ℹ️  Add ${install_dir} to PATH to use sitesctl directly in future shells."
    fi
    sitesctl_command=${install_path}
}

sitesctl_command=$(command -v sitesctl || true)
if [[ -z "${sitesctl_command}" ]]; then
    install_sitesctl
fi

site_command=(
    "${sitesctl_command}" site
    --space "${site_space}"
    --name "${site_name}"
)
upload_options=(
    content upload --force
)

run_upload() {
    local source=$1
    local command=(
        "${site_command[@]}"
        --api-authentication-token "${sites_api_token}"
        "${upload_options[@]}"
        --source "${source}"
    )
    command+=(--destination "${destination}")
    "${command[@]}" 2>&1 |
        sed -e '/^[[:space:]]*$/d' \
            -e "/^User specified '--force', continuing without prompting for confirmation$/d"
}

upload_with_retry() {
    local source=$1
    local attempt=1
    local maximum_attempts=3
    local retry_delay=2

    while ! run_upload "${source}"; do
        if [[ ${attempt} -ge ${maximum_attempts} ]]; then
            echo "ERROR: upload failed after ${maximum_attempts} attempts: ${source}" >&2
            return 1
        fi
        attempt=$((attempt + 1))
        echo "⚠️  Upload failed; resuming ${source##*/} in ${retry_delay}s (attempt ${attempt}/${maximum_attempts})..." >&2
        sleep "${retry_delay}"
        retry_delay=$((retry_delay * 2))
    done
}

if [[ "${dryrun}" == true ]]; then
    echo "🔍 Dry run: planned uploads"
    for atlas_file in "${atlas_files[@]}"; do
        printf '+ sitesctl site --space %q --name %q --api-authentication-token %q content upload --force' "${site_space}" "${site_name}" '<redacted>'
        printf ' --source %q --destination %q\n' "${atlas_file}" "${destination}"
    done
    printf '+ sitesctl site --space %q --name %q --api-authentication-token %q content upload --force' "${site_space}" "${site_name}" '<redacted>'
    printf ' --source %q --destination %q\n' "${output_dir}/grids.yaml" "${destination}"
    exit 0
fi

sites_api_token=${SITES_API_TOKEN:-}
unset SITES_API_TOKEN
if [[ -z "${sites_api_token}" ]]; then
    if [[ ! -t 0 ]]; then
        echo "ERROR: SITES_API_TOKEN is unset and no interactive terminal is available" >&2
        exit 1
    fi
    read -r -s -p "🔑 Sites API access token: " sites_api_token
    printf '\n'
fi
if [[ -z "${sites_api_token}" ]]; then
    echo "ERROR: Sites API access token must not be empty" >&2
    exit 1
fi

if [[ "${force}" != true ]]; then
    if [[ ! -t 0 ]]; then
        echo "ERROR: no interactive terminal is available; use --force to upload without confirmation" >&2
        exit 1
    fi
    printf 'Upload %d .atlas grid data files and grids.yaml to %s? [y/N] ' "${#atlas_files[@]}" "${target_url}"
    read -r answer
    case "${answer}" in
        y|Y|yes|YES) ;;
        *)
            echo "Upload cancelled."
            exit 0
            ;;
    esac
fi

echo "📦 Uploading ${#atlas_files[@]} .atlas grid data files..."
for atlas_file in "${atlas_files[@]}"; do
    echo "⬆️  ${atlas_file##*/}"
    upload_with_retry "${atlas_file}"
    echo "✅ ${atlas_file##*/} uploaded."
done
echo "📄 Uploading grids.yaml..."
upload_with_retry "${output_dir}/grids.yaml"
echo "✅ grids.yaml uploaded."
unset sites_api_token

echo "✅ Uploaded ${#atlas_files[@]} .atlas grid data files and grids.yaml to"
echo "${target_url}"